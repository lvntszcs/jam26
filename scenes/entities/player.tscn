[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/entities/player.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/lighting/player_light.gd" id="2_light"]
[ext_resource type="AudioStream" path="res://audio/sfx/one_step.wav" id="3_footstep"]

[sub_resource type="CircleShape2D" id="body"]
radius = 45.0

[node name="Player" type="CharacterBody2D"]
